// 代購網站 Prisma schema（v3：貼近應用實際資料模型）
// 巢狀資料（商品規格 / 訂單品項 / 圖片等）以 JSON 欄位保存，
// 對應 src/lib/*-store.ts 的型別，讓資料層轉換近乎 1:1。
// 產生 client：npx prisma generate
// 建立/套用 migration：npx prisma migrate dev

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------
// Auth.js 標準模型（保留供日後 Email 註冊 / LINE 登入；目前尚未寫入）
// ------------------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  role          String    @default("CUSTOMER") // CUSTOMER / ADMIN
  passwordHash  String? // Email 直接註冊用（雜湊後）
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String // google / line
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------------------------------------------
// 網站設定（單一列，id 固定為 "singleton"）
// ------------------------------------------------------------------
model SiteSettings {
  id                    String   @id @default("singleton")
  name                  String
  tagline               String
  announcement          String
  freeShippingThreshold Int
  shippingFee           Int
  lineId                String
  lineUrl               String
  email                 String
  productCountDisplay   String // none / sold / stock
  lowStockThreshold     Int
  botEnabled            Boolean
  botMessage            String
  updatedAt             DateTime @updatedAt
}

// ------------------------------------------------------------------
// 商品分類
// ------------------------------------------------------------------
model Category {
  slug      String @id
  name      String
  emoji     String
  sortOrder Int    @default(0)
}

// ------------------------------------------------------------------
// 商品（規格 / 選項 / 圖片以 JSON 欄位保存）
// ------------------------------------------------------------------
model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  categorySlug String
  description  String
  price        Int // 最低規格價（列表顯示用）
  gradient     Json // [string, string] 佔位圖漸層
  images       Json // ProductImage[]
  optionGroups Json // OptionGroup[]
  variants     Json // Variant[]（id / options / price / stock）
  status       String   @default("ACTIVE") // ACTIVE / ARCHIVED / DRAFT
  views        Int      @default(0) // 商品頁被瀏覽次數
  featured     Boolean  @default(false) // 首頁「精選推薦」是否顯示
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([categorySlug])
  @@index([status])
}

// ------------------------------------------------------------------
// 訂單（品項 / 退換貨等以 JSON 欄位保存快照）
// ------------------------------------------------------------------
model Order {
  orderNo            String   @id
  userId             String
  userEmail          String
  userName           String
  status             String // PENDING / CONFIRMED / SHIPPED / COMPLETED / CANCELLED
  cancelledBy        String? // customer / admin
  abandoned          Boolean  @default(false)
  cancellationReason String?
  previousStatus     String?
  returnRequest      Json? // { reason, createdAt }
  items              Json // OrderItem[]
  subtotal           Int
  shippingFee        Int
  codFee             Int      @default(0)
  totalAmount        Int
  recipientName      String
  recipientPhone     String
  storeId            String // 7-11 取貨門市代號
  storeName          String
  storeAddress       String
  customerNote       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// 全域流水號（訂單編號等）
model Counter {
  name  String @id
  value Int    @default(0)
}

// ------------------------------------------------------------------
// 庫存異動流水
// ------------------------------------------------------------------
model InventoryMovement {
  id           String   @id @default(cuid())
  variantId    String
  productTitle String
  optionLabel  String
  type         String // SALE / CANCEL / RESTOCK / ADJUST
  delta        Int
  reason       String
  orderNo      String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// ------------------------------------------------------------------
// 客戶標記與備註（僅賣家可見）
// ------------------------------------------------------------------
model CustomerProfile {
  userId     String   @id
  manualFlag String   @default("NORMAL") // NORMAL / WATCH / BLOCKED
  sellerNote String   @default("")
  updatedAt  DateTime @updatedAt
}

// ------------------------------------------------------------------
// 常用取貨資料（賣貨便）：記住顧客上次的取貨人/電話/門市，結帳自動帶入
// ------------------------------------------------------------------
model PickupProfile {
  userId         String   @id
  recipientName  String
  recipientPhone String
  storeId        String
  storeName      String
  storeAddress   String
  updatedAt      DateTime @updatedAt
}

// ------------------------------------------------------------------
// 常用收件地址（宅配用；目前結帳走賣貨便門市，保留供日後宅配選項）
// ------------------------------------------------------------------
model Address {
  id             String   @id @default(cuid())
  userId         String
  recipientName  String
  recipientPhone String
  city           String
  district       String
  addressLine    String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([userId])
}
