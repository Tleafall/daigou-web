# ── 環境變數範本 ──────────────────────────────────────────────
# 複製這個檔成 .env，把下面的值換成真的。.env 不會進版控（含機密）。
# 真正的機密值請用隨身碟或密碼管理器帶到新電腦，不要用 email/GitHub 傳。

# 資料庫連線（本機 PostgreSQL）
# 格式：postgresql://<帳號>:<密碼>@localhost:5432/<資料庫名>?schema=public
# 新電腦可自訂新密碼；資料庫名沿用 daigou
DATABASE_URL="postgresql://postgres:改成你的密碼@localhost:5432/daigou?schema=public"

# Auth.js 簽章金鑰（保護登入 session）
# 新電腦可用指令重新產生：npx auth secret（或 openssl rand -base64 32）
AUTH_SECRET="改成一段隨機字串"

# Cloudinary 圖床（商品圖片）— 這三個要沿用同一組（換了舊圖網址會失效）
CLOUDINARY_CLOUD_NAME="你的 cloud name"
CLOUDINARY_API_KEY="你的 api key"
CLOUDINARY_API_SECRET="你的 api secret"
